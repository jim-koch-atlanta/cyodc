# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Where LangGraph's SqliteSaver checkpointer writes session state.
CYODC_CHECKPOINT_DB=./data/checkpoints.sqlite

# CORS origin for the Vite dev server.
CYODC_FRONTEND_ORIGIN=http://localhost:5173

# Model backend: "auto" (default) uses Anthropic when a key is present, else the
# offline stub narrator. Force one with "anthropic" or "stub".
CYODC_LLM_MODE=auto
